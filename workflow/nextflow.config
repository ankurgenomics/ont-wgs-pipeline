#! usr/bin/env nextflow

/*
* EDIT AND SETUP PIPELINE PARAMETERS HERE
*/

// If running in AWS batch, nextflow requires an S3 bucket workdir
workDir = "s3://<your-bucket>/ont_wgs/temp/"

params {
    project = "ONT_WGS_GERMLINE_run"
    outdir = "s3://<your-bucket>/ont_wgs/results/"

// SAMPLES
    reads = 'samples.csv'

// REFERENCE
    ref = 's3://<your-reference-bucket>/GRCh38/Homo_sapiens_assembly38.fasta'
    fai = ref + '.fai'

// CLAIR3 MODEL (matched to basecaller model used, e.g. r1041_e82_400bps_sup_v500)
    clair3_model = 's3://<your-reference-bucket>/clair3_models/r1041_e82_400bps_sup_v500'

// Optional: set true to run 5mC methylation calling (requires modified-base BAM tags from basecalling)
    call_methylation = false
}

/*
* EDIT CPU AND MEMORY USAGE HERE
*/

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    withLabel: med {
        cpus = 14
        memory = 28.GB
    }
    withLabel: lg {
        cpus = 30
        memory = 55.GB
    }
    withLabel: xl {
	cpus = 60
	memory = 115.GB
    }
}

profiles {
    standard {
	process.executor = 'local'
    }

    cloud {
	process {
	    executor = 'awsbatch'
	    maxRetries = 3
	    errorStrategy = 'finish'
	    shell = ['/bin/bash', '-euo', 'pipefail']
	    withLabel: med {
			queue = '<your-batch-queue-med>'
			cpus = 14
			memory = 28.GB
			}
	    withLabel: lg {
			queue = '<your-batch-queue-lg>'
			cpus = 30
			memory = 55.GB
			}
	    withLabel: xl {
			queue = '<your-batch-queue-xl>'
			cpus = 60
			memory = 115.GB
			}
	}
	aws.region = '<your-aws-region>'
	aws.client.maxErrorRetry = 5
	aws.client.uploadMaxAttempts = 5
	aws.client.maxConnections = 4
	aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
	aws.batch.maxParallelTransfers = 8
	aws.batch.maxTransferAttempts = 5
    }
    docker {
	docker.enabled = true
	docker.runOptions = '-u \$(id -u):\$(id -g)'
    }
}

plugins {
    id 'nf-amazon'
}

def trace_timestamp = new java.util.Date().format( 'yyyyMMdd_HHmm')

report {
    enabled = true
    file = "${params.project}_${trace_timestamp}_report.html"
}

trace {
    enabled = true
    file = "${params.project}_${trace_timestamp}_trace.txt"
    fields = "task_id,name,status,realtime,duration,cpus,%cpu,memory,rss,%mem,peak_vmem,hash,script"
}

timeline {
    enabled = true
    file = "${params.project}_${trace_timestamp}_timeline.html"
}
